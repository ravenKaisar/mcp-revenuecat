{
  "name": "@kaisar/mcp-revenuecat",
  "version": "1.0.0",
  "description": "Multi-project RevenueCat MCP gateway: one endpoint in front of mcp.revenuecat.ai, routing each call to the API key of the right project.",
  "type": "module",
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "validate:config": "tsx src/scripts/validateConfig.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "mcp-revenuecat": "dist/src/index.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
